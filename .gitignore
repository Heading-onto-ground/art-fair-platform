# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
mobile/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
mobile/dist

# misc
.DS_Store
*.pem
cloudflared*.exe

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# local database backups (contain user data; never commit)
backups/

# local credential exports (never commit)
scripts/output/*.csv
scripts/output/*.txt
scripts/partners.csv

# Cursor editor
.cursor/

# local launcher isolation
.logs/

# Art history pilot: fetched page bodies stay local and are not product data.
experiments/art-history-pilot/.local-snapshots/
